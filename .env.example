# Database
DATABASE_URL=postgresql+asyncpg://terraguard:terraguard@localhost:5432/terraguard
DATABASE_URL_SYNC=postgresql://terraguard:terraguard@localhost:5432/terraguard

# Security
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# External APIs
WEATHER_API_KEY=

# Mode
DEMO_MODE=true

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
